# Copy file nay thanh .env va dien API key that.
# Khong commit .env len git.

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Neu sau nay can model reasoning:
# DEEPSEEK_MODEL=deepseek-reasoner
# Truong JSON gop vao moi request chat, vd. tat suy luan (ten tham so tuy provider):
# DEEPSEEK_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Runtime settings
AUTO_BUILD_INDEX=false
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_PROFILE=vietnamese
EMBEDDING_DEVICE=auto
# onnx (ONNX Runtime tren CPU, mac dinh) hoac torch; GPU luon dung torch
EMBEDDING_RUNTIME=onnx
RERANKER_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
RERANKER_BATCH_SIZE=4

# Tracing LangSmith (tat mac dinh). Tao API key tai smith.langchain.com; khong commit key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legal-rag
# Vung EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Ty le trace duoc gui (0-1); ha xuong khi chay eval nhieu cau de tiet kiem quota.
LANGSMITH_TRACING_SAMPLING_RATE=1
# true: khong gui noi dung cau hoi/context/cau tra loi, chi gui cau truc trace, thoi gian, token, metadata.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
